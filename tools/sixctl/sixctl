#!/usr/bin/env python3
"""sixctl - the ipv6-fun flagship CLI.

recon (addrs, ndp), explain (pure stdlib, offline), and scan work today with iproute2 + iputils ping
(no scapy). scan does link enumeration (multicast + NDP cache) and prefix
target-generation (RFC 7707 style). ra and craft need scapy and are stubbed
until their own pass - see demos/10-attack-lab/README.md for the reasoning.
"""

import argparse
import ipaddress
import re
import subprocess
import sys


def classify(addr: str) -> str:
    a = addr.lower()
    if a == "::1":
        return "loopback"
    if a.startswith("fe80:"):
        return "link-local unicast"
    if re.match(r"^f[cd][0-9a-f]{2}:", a):
        return "unique local (ULA)"
    if a.startswith("ff0"):
        return "multicast"
    if a.startswith(("2", "3")):
        return "global unicast (GUA)"
    return "unknown/other"


def run_ip(args: list[str]) -> str:
    try:
        result = subprocess.run(
            ["ip", *args], capture_output=True, text=True, check=True
        )
    except FileNotFoundError:
        print("sixctl needs iproute2 (the 'ip' command) - Linux only", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as exc:
        print(exc.stderr, file=sys.stderr)
        sys.exit(exc.returncode)
    return result.stdout


def cmd_addrs(_args: argparse.Namespace) -> None:
    output = run_ip(["-6", "addr", "show"])
    iface = ""
    for line in output.splitlines():
        m = re.match(r"^\d+:\s+([^:@]+)", line)
        if m:
            iface = m.group(1)
            continue
        m = re.search(
            r"inet6\s+([0-9a-fA-F:]+)/(\d+)\s+scope\s+(\S+)(.*)", line
        )
        if m:
            addr, prefix, scope, flags = m.groups()
            print(f"{iface:<10} {addr}/{prefix}")
            print(f"{'':<10} scope={scope}  type={classify(addr)}{flags}")


def cmd_ndp(_args: argparse.Namespace) -> None:
    output = run_ip(["-6", "neigh", "show"])
    if not output.strip():
        print("(neighbor cache is empty)")
        return
    for line in output.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        addr = parts[0]
        print(f"{addr:<40} type={classify(addr):<22} {' '.join(parts[1:])}")


LOW_WORDS = [
    "::1", "::2", "::3", "::a", "::10", "::20", "::53", "::80", "::443",
    "::8080", "::1000", "::dead:beef", "::c0:ffee", "::cafe", "::babe",
    "::f00d", "::bad:c0de", "::1:1",
]


def eui64_iid(mac):
    """MAC -> the 64-bit SLAAC interface ID (flip the U/L bit, insert ff:fe)."""
    octets = re.findall(r"[0-9a-fA-F]{2}", mac)
    if len(octets) != 6:
        return None
    b = [int(x, 16) for x in octets]
    b[0] ^= 0x02
    iid = bytes([b[0], b[1], b[2], 0xFF, 0xFE, b[3], b[4], b[5]])
    return int.from_bytes(iid, "big")


def gen_candidates(net, mac):
    """The addresses a real scanner predicts instead of brute-forcing 2^64."""
    base = int(net.network_address)
    out, seen = [], set()

    def add(host_int):
        addr = ipaddress.IPv6Address(base + host_int)
        if addr in net and addr not in seen:
            seen.add(addr)
            out.append(addr)

    for suf in LOW_WORDS:                     # low / memorable / service IIDs
        add(int(ipaddress.IPv6Address(suf)))
    for i in range(0x100, 0x10B):             # sequential DHCPv6-style pool
        add(i)
    if mac:                                   # the EUI-64 SLAAC leak
        iid = eui64_iid(mac)
        if iid is not None:
            add(iid)
    return out


def ping6(addr, iface=None, wait=1):
    """True if addr answers an ICMPv6 echo. Uses iputils ping (no scapy)."""
    target = addr
    if iface and (addr.startswith("fe80") or addr.startswith("ff0")):
        target = f"{addr}%{iface}"
    try:
        r = subprocess.run(
            ["ping", "-6", "-c", "1", "-W", str(wait), target],
            capture_output=True, text=True,
        )
    except FileNotFoundError:
        print("sixctl scan needs 'ping' (iputils) - Linux only", file=sys.stderr)
        sys.exit(1)
    return r.returncode == 0, r.stdout


def detect_iface():
    cur = None
    for line in run_ip(["-6", "addr", "show"]).splitlines():
        m = re.match(r"^\d+:\s+([^:@]+)", line)
        if m:
            cur = m.group(1)
        elif "inet6 fe80:" in line and cur and cur != "lo":
            return cur
    return None


def scan_link(iface):
    print(f"# link sweep on {iface}: solicit ff02::1 (all-nodes), then read the NDP cache")
    _, out = ping6("ff02::1", iface=iface, wait=2)
    found = {}
    for a in re.findall(r"bytes from ([0-9a-fA-F:]+)(?:%\w+)?:", out):
        found.setdefault(a, "echo-reply")
    for line in run_ip(["-6", "neigh", "show"]).splitlines():
        p = line.split()
        if p and ":" in p[0]:
            found.setdefault(p[0], "ndp-cache")
    if not found:
        print("(no neighbors answered - try another --iface, or one on the target link)")
        return
    for a in sorted(found):
        print(f"{a:<42} {classify(a):<22} via {found[a]}")


def solicited_node(addr):
    """The ff02::1:ffXX:XXXX group this address listens to for NDP."""
    return ipaddress.IPv6Address(int(ipaddress.IPv6Address("ff02::1:ff00:0")) | (int(addr) & 0xFFFFFF))


def iid_to_mac(addr):
    """If the interface ID is EUI-64 (ff:fe in the middle), recover the source MAC."""
    b = addr.packed[8:16]
    if b[3] == 0xFF and b[4] == 0xFE:
        m = bytes([b[0] ^ 0x02, b[1], b[2], b[5], b[6], b[7]])
        return ":".join(f"{x:02x}" for x in m)
    return None


def _iid_str(addr):
    return ":".join(addr.exploded.split(":")[4:])


def explain_addr(addr, net):
    row = lambda k, v: print(f"{k:<15} {v}")
    row("input", str(addr))
    row("type", classify(str(addr)))
    row("compressed", addr.compressed)
    row("expanded", addr.exploded)
    row("reverse DNS", addr.reverse_pointer)
    row("solicited-node", str(solicited_node(addr)))
    row("interface ID", _iid_str(addr))
    mac = iid_to_mac(addr)
    if mac:
        row("EUI-64 -> MAC", f"{mac}   (SLAAC MAC-derived; U/L bit flipped back)")
    if addr.ipv4_mapped:
        row("IPv4-mapped", f"{addr.ipv4_mapped}   (::ffff:0:0/96)")
    if addr.sixtofour:
        row("6to4 IPv4", f"{addr.sixtofour}   (2002::/16)")
    if addr.teredo:
        row("Teredo", f"server {addr.teredo[0]}  client {addr.teredo[1]}")
    if addr in ipaddress.ip_network("64:ff9b::/96"):
        row("NAT64 IPv4", f"{ipaddress.IPv4Address(addr.packed[12:16])}   (64:ff9b::/96)")
    if net is not None:
        n = net.num_addresses
        row("prefix", str(net))
        row("  network", str(net.network_address))
        extra = f"  ({n >> 64:,} x /64)" if net.prefixlen < 64 else ""
        row("  size", f"2^{128 - net.prefixlen} = {n:,} addrs{extra}")
        row("  range", f"{net.network_address} .. {net.broadcast_address}")


def explain_mac(mac):
    iid = eui64_iid(mac)
    ll = ipaddress.IPv6Address(int(ipaddress.IPv6Address("fe80::")) | iid)
    print(f"{'input MAC':<15} {mac}")
    print(f"{'EUI-64 IID':<15} {_iid_str(ipaddress.IPv6Address(iid))}   (ff:fe inserted, U/L bit flipped)")
    print(f"{'link-local':<15} {ll}   (fe80:: + IID -- the SLAAC address this MAC self-assigns)")
    print(f"{'solicited-node':<15} {solicited_node(ll)}")
    print("append that IID to any /64 to get its EUI-64 SLAAC address (guessable -- see 'scan --predict')")


def cmd_explain(args):
    t = args.target.strip()
    if re.fullmatch(r"([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}", t):
        explain_mac(t.replace("-", ":"))
        return
    try:
        net = ipaddress.ip_network(t, strict=False) if "/" in t else None
        addr = ipaddress.IPv6Address(t.split("/")[0])
    except ValueError as exc:
        print(f"not an IPv6 address / prefix / MAC: {t}  ({exc})", file=sys.stderr)
        sys.exit(1)
    if net is not None and net.version != 6:
        print("that's an IPv4 prefix - this translates IPv6", file=sys.stderr)
        sys.exit(1)
    explain_addr(addr, net)


LEET = {"o": "0", "i": "1", "l": "1", "s": "5", "t": "7", "z": "2", "g": "9", "q": "9"}
GALLERY = ["1", "1337", "deadbeef", "c0ffee", "cafebabe", "badc0de", "feedface", "acce55", "d0d0", "f00d"]


def leet_hex(word):
    """Render a word as hex nibbles (native a-f plus leet o/i/l/s/t/z/g)."""
    out, bad = [], []
    for ch in word.lower():
        if ch in "0123456789abcdef":
            out.append(ch)
        elif ch in LEET:
            out.append(LEET[ch])
        else:
            bad.append(ch)
    return "".join(out), sorted(set(bad))


def cmd_vanity(args):
    try:
        net = ipaddress.ip_network(args.prefix, strict=False)
    except ValueError as exc:
        print(f"bad prefix: {exc}", file=sys.stderr)
        sys.exit(1)
    if net.version != 6:
        print("vanity needs an IPv6 prefix", file=sys.stderr)
        sys.exit(1)
    base = int(net.network_address)

    if args.word:
        hexs, bad = leet_hex(args.word)
        if not hexs:
            print(f"can't render '{args.word}' - no chars map to hex", file=sys.stderr)
            sys.exit(1)
        if len(hexs) > 16:
            print(f"# '{args.word}' is {len(hexs)} nibbles; keeping the last 16 (64-bit IID)")
            hexs = hexs[-16:]
        addr = ipaddress.IPv6Address(base + int(hexs, 16))
        print(f"# vanity address for '{args.word}' in {net}")
        print(f"  {addr}")
        if bad:
            print(f"  (dropped unmappable letters: {' '.join(bad)}; only 0-9 a-f + leet o i l s t z g map)")
        print("  cute == guessable: this is exactly the low-entropy IID a target-generator")
        print("  tries first (see 'sixctl scan --predict'). Great for a lab, terrible for hiding.")
    else:
        print(f"# hall-of-fame vanity IIDs in {net} (all trivially guessable):")
        for w in GALLERY:
            print(f"  {ipaddress.IPv6Address(base + int(w, 16))}   (from '{w}')")
        print("encode your own:  sixctl vanity <prefix> deadbeef")


def _sysctl(key):
    try:
        r = subprocess.run(["sysctl", "-n", key], capture_output=True, text=True)
        return r.stdout.strip() or "?"
    except FileNotFoundError:
        return "?"


def iid_grade(addr):
    """Grade an interface ID's guessability: A (opaque) down to F (MAC-derived)."""
    b = addr.packed[8:16]
    iid = int.from_bytes(b, "big")
    if b[3] == 0xFF and b[4] == 0xFE:
        return "F", "EUI-64 - your MAC is in the address"
    if iid == 0:
        return "F", "all-zero IID (subnet-router anycast)"
    if iid < 0x1_0000:
        return "D", "low/small IID - a scanner's first guesses"
    if len(set(b)) <= 3:
        return "C", "low-entropy / repetitive byte pattern"
    return "A", "opaque - random or RFC 7217 stable-privacy"


def _globals_on(iface):
    out = []
    for line in run_ip(["-6", "-o", "addr", "show", "dev", iface, "scope", "global"]).splitlines():
        m = re.search(r"inet6 ([0-9a-fA-F:]+)/(\d+)", line)
        if m:
            out.append((ipaddress.IPv6Address(m.group(1)), int(m.group(2))))
    return out


def cmd_audit(args):
    iface = args.iface or detect_iface()
    if not iface:
        print("no interface with a global IPv6 address - pass one", file=sys.stderr)
        sys.exit(1)
    ranks = {"A": 0, "B": 1, "C": 2, "D": 3, "F": 4}
    worst = None
    print(f"== sixctl audit: IPv6 exposure of {iface} ==")
    print("-- addresses (guessability grade) --")
    globs = _globals_on(iface)
    for a, _p in globs:
        g, why = iid_grade(a)
        print(f"  {str(a):<40} [{g}] {why}")
        if worst is None or ranks[g] > ranks[worst]:
            worst = g
    if not globs:
        print("  (no global addresses)")

    print("-- knobs --")
    ar = _sysctl(f"net.ipv6.conf.{iface}.accept_ra")
    fwd = _sysctl("net.ipv6.conf.all.forwarding")
    ut = _sysctl(f"net.ipv6.conf.{iface}.use_tempaddr")
    mark = lambda bad, msg: print(f"  [{'!' if bad else '+'}] {msg}")
    mark(ut != "2", f"use_tempaddr={ut}  " + ("(no privacy temp addrs; prefer 2)" if ut != "2" else "(privacy on)"))
    mark(ar != "0" and fwd != "1", f"accept_ra={ar}  " + ("(accepts ANY RA -> rogue-RA risk; see 'sixctl ra-watch')" if ar != "0" else "(RAs ignored)"))
    mark(fwd == "1", f"forwarding={fwd}  " + ("(this box ROUTES v6 - intended only if it's a router)" if fwd == "1" else "(host, not routing)"))

    print("-- inbound firewall (no NAT in v6, so it's the whole perimeter) --")
    seen = False
    try:
        r = subprocess.run(["nft", "list", "ruleset"], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            seen = True
            deny = "policy drop" in r.stdout
            mark(not deny, "nftables: " + ("default-deny inbound detected" if deny else "no obvious default-deny - verify input/forward policy"))
    except FileNotFoundError:
        pass
    if not seen:
        print("  [?] couldn't read the ruleset (run as root, or none configured)")

    print(f"-- headline: worst address grade [{worst or '-'}]  (A opaque .. F MAC-derived) --")
    if worst in ("D", "F"):
        print("  fix: sysctl use_tempaddr=2 (privacy addrs) or RFC 7217 stable-privacy IIDs.")


def cmd_canary(args):
    if args.action == "watch":
        print("watching the kernel log for canary hits (Ctrl-C to stop)...")
        subprocess.run(["sh", "-c",
                        "journalctl -kf 2>/dev/null | grep --line-buffered sixctl-canary "
                        "|| dmesg -w | grep --line-buffered sixctl-canary"])
        return
    iface = args.iface
    if not iface:
        print("canary up/down needs --iface", file=sys.stderr)
        sys.exit(1)
    addr = args.addr
    if not addr:
        g = _globals_on(iface)
        if not g:
            print("no global /64 on that iface - pass --addr", file=sys.stderr)
            sys.exit(1)
        net = ipaddress.ip_network(f"{g[0][0]}/{g[0][1]}", strict=False)
        addr = str(ipaddress.IPv6Address(int(net.network_address) | 0xBABE))
    if args.action == "up":
        print(f"planting canary {addr} on {iface} (needs root)")
        subprocess.run(["sudo", "ip", "-6", "addr", "add", f"{addr}/128", "dev", iface])
        rules = ('table inet sixctl_canary {\n'
                 '  chain input {\n'
                 '    type filter hook input priority -300; policy accept;\n'
                 f'    ip6 daddr {addr} log prefix "sixctl-canary: " level warn\n'
                 '  }\n}\n')
        subprocess.run(["sudo", "nft", "-f", "-"], input=rules, text=True)
        print(f"any packet to {addr} now logs 'sixctl-canary:' to the kernel log.")
        print("legit traffic uses your real random address, so a hit here == a scanner.")
        print(f"  watch:  sixctl canary watch\n  stop :  sixctl canary down --iface {iface} --addr {addr}")
    else:
        subprocess.run(["sudo", "nft", "delete", "table", "inet", "sixctl_canary"])
        subprocess.run(["sudo", "ip", "-6", "addr", "del", f"{addr}/128", "dev", iface])
        print("canary removed (table + address).")


def cmd_ra_watch(args):
    iface = args.iface or detect_iface()
    known = set()
    for line in run_ip(["-6", "route", "show", "default"]).splitlines():
        m = re.search(r"default via (\S+)", line)
        if m:
            known.add(m.group(1))
    print(f"== sixctl ra-watch{(' on ' + iface) if iface else ''} ==")
    print(f"trusted default router(s): {', '.join(sorted(known)) or '(none yet)'}")
    print("watching for a NEW default router / prefix appearing - what a rogue RA installs.")
    print("dependency-light (ip monitor, no root). Ctrl-C to stop.")
    print("(full capture incl. non-routing RAs: nft log icmpv6 type 134, or rdisc6.)")
    p = subprocess.Popen(["ip", "-6", "monitor", "route"], stdout=subprocess.PIPE, text=True)
    try:
        for line in p.stdout:
            m = re.search(r"default via (\S+)", line)
            if m and m.group(1) not in known:
                known.add(m.group(1))
                print(f"  [ALERT] new default router {m.group(1)} - possible ROGUE RA!")
            elif re.match(r"^[23][0-9a-fA-F:]+/\d", line.strip()):
                print(f"  [note] new global prefix route: {line.strip()}")
    except KeyboardInterrupt:
        p.terminate()


def load_seed(path):
    """Read observed/hitlist IPv6 addresses (one per line, '#' comments, first token)."""
    addrs = []
    try:
        with open(path) as fh:
            for line in fh:
                s = line.strip()
                if not s or s.startswith("#"):
                    continue
                tok = re.split(r"[\s,]", s)[0]
                try:
                    addrs.append(ipaddress.IPv6Address(tok))
                except ValueError:
                    continue
    except OSError as exc:
        print(f"seed file: {exc}", file=sys.stderr)
        sys.exit(1)
    return addrs


def cmd_scan(args):
    # target-list mode: predict from a prefix and/or ingest a seed/hitlist file.
    # generation and probing are decoupled -- --out hands the list to any prober.
    if args.predict or args.seed:
        net = None
        if args.predict:
            try:
                net = ipaddress.ip_network(args.predict, strict=False)
            except ValueError as exc:
                print(f"bad prefix: {exc}", file=sys.stderr)
                sys.exit(1)
            if net.version != 6:
                print("scan --predict needs an IPv6 prefix", file=sys.stderr)
                sys.exit(1)

        cands, seen = [], set()

        def add(a):
            if a not in seen:
                seen.add(a)
                cands.append(a)

        if net is not None:
            for a in gen_candidates(net, args.mac):
                add(a)
        if args.seed:
            for a in load_seed(args.seed):
                add(a)

        srcs = []
        if net is not None:
            srcs.append(f"predict {net}")
        if args.seed:
            srcs.append(f"seed {args.seed}")
        print(f"# target list ({len(cands)} candidates) from: {', '.join(srcs)}")
        if net is not None:
            print(f"# a /{net.prefixlen} is 2^{128 - net.prefixlen} addresses; this is the RFC 7707")
            print("# low-entropy subset (low/word IIDs, DHCP pools, EUI-64) -- not brute force.")
        if args.out:
            try:
                with open(args.out, "w") as fh:
                    for c in cands:
                        fh.write(f"{c}\n")
            except OSError as exc:
                print(f"--out: {exc}", file=sys.stderr)
                sys.exit(1)
            print(f"# wrote {len(cands)} addresses to {args.out} -- feed zmap/masscan/scan6/ping")
        for c in cands:
            if args.probe:
                live, _ = ping6(str(c), iface=args.iface, wait=args.wait)
                print(f"{str(c):<42} {classify(str(c)):<22} {'LIVE' if live else '-'}")
            else:
                print(f"{str(c):<42} {classify(str(c))}")
        return

    iface = args.iface or detect_iface()
    if not iface:
        print("no link-local interface found - pass --iface", file=sys.stderr)
        sys.exit(1)
    scan_link(iface)


def cmd_not_implemented(name: str):
    def handler(_args: argparse.Namespace) -> None:
        print(f"sixctl {name}: not yet implemented (needs scapy)", file=sys.stderr)
        sys.exit(1)

    return handler


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sixctl", description="ipv6-fun flagship CLI"
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_addrs = sub.add_parser("addrs", help="list & classify IPv6 addresses")
    p_addrs.set_defaults(func=cmd_addrs)

    p_ndp = sub.add_parser("ndp", help="dump the neighbor (NDP) cache")
    p_ndp.set_defaults(func=cmd_ndp)

    p_explain = sub.add_parser("explain", help="translate an IPv6 address / prefix / MAC to all its forms")
    p_explain.add_argument("target", help="IPv6 addr (2001:db8::1), prefix (2001:db8::/48), or a MAC")
    p_explain.set_defaults(func=cmd_explain)

    p_vanity = sub.add_parser("vanity", help="make a cute/leet IPv6 address in a prefix (fun; also = guessable)")
    p_vanity.add_argument("prefix", help="IPv6 prefix, e.g. 2001:db8:0:1::/64")
    p_vanity.add_argument("word", nargs="?", help="word to leet-encode into the interface ID (omit for a gallery)")
    p_vanity.set_defaults(func=cmd_vanity)

    p_audit = sub.add_parser("audit", help="score this host's IPv6 exposure (address grades, RA risk, firewall)")
    p_audit.add_argument("iface", nargs="?", help="interface (default: first with a global address)")
    p_audit.set_defaults(func=cmd_audit)

    p_canary = sub.add_parser("canary", help="plant a decoy address that logs any scanner that touches it")
    p_canary.add_argument("action", choices=["up", "watch", "down"])
    p_canary.add_argument("--iface", help="interface to plant the canary on")
    p_canary.add_argument("--addr", help="canary address (default: <iface /64>::babe)")
    p_canary.set_defaults(func=cmd_canary)

    p_rawatch = sub.add_parser("ra-watch", help="passively alert on new/rogue Router Advertisements")
    p_rawatch.add_argument("iface", nargs="?", help="interface (default: first with a global address)")
    p_rawatch.set_defaults(func=cmd_ra_watch)

    p_ra = sub.add_parser("ra", help="[TODO] sniff or send router advertisements")
    p_ra.add_argument("action", choices=["sniff", "send"])
    p_ra.set_defaults(func=cmd_not_implemented("ra"))

    p_scan = sub.add_parser(
        "scan", help="enumerate the link (multicast+NDP) or target-generate from a prefix"
    )
    p_scan.add_argument("--iface", help="interface for the link sweep / link-local probes")
    p_scan.add_argument("--predict", metavar="PREFIX",
                        help="target-generate likely-live addresses from a prefix "
                             "(e.g. 2001:db8:0:1::/64) instead of scanning the link")
    p_scan.add_argument("--mac", help="with --predict: also derive the EUI-64 SLAAC address")
    p_scan.add_argument("--seed", metavar="FILE",
                        help="ingest observed/hitlist IPv6 addresses (one per line) into the target set")
    p_scan.add_argument("--out", metavar="FILE",
                        help="write the candidate list (one address per line) for zmap/masscan/scan6")
    p_scan.add_argument("--probe", action="store_true",
                        help="actually ping each candidate")
    p_scan.add_argument("--wait", type=int, default=1, help="per-probe timeout seconds (default 1)")
    p_scan.set_defaults(func=cmd_scan)

    p_craft = sub.add_parser("craft", help="[TODO] interactive header-chain builder")
    p_craft.set_defaults(func=cmd_not_implemented("craft"))

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
